{
  "name": "file-upload-download-server",
  "version": "1.0.0",
  "description": "Node.js服务支持文件上传和下载",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "docker:build": "docker build -t file-upload-server .",
    "docker:run": "docker run -p 3001:3001 file-upload-server",
    "docker:compose": "docker-compose up -d"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "nodejs",
    "express",
    "file-upload",
    "file-download"
  ],
  "author": "",
  "license": "MIT"
}
